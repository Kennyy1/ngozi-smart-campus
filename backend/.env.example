APP_NAME=Ngozi Smart Campus API
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ngozi_smart_campus
DATABASE_USER=ngozi_admin
DATABASE_PASSWORD=replace_with_local_database_password
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=ngozi-smart-campus
JWT_AUDIENCE=ngozi-smart-campus-api
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Local development seed only. Never use these placeholder values in production.
DEVELOPMENT_SEED_INSTITUTION_CODE=NGOZI
DEVELOPMENT_SEED_INSTITUTION_NAME=Ngozi University
DEVELOPMENT_SEED_ADMIN_EMAIL=admin@ngozi.local
DEVELOPMENT_SEED_ADMIN_PASSWORD=replace-with-a-local-development-password
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
